{
  "name": "agent-studio",
  "version": "0.2.0",
  "description": "A local workspace for your AI agents, powered by your existing CLI subscriptions.",
  "type": "module",
  "scripts": {
    "relay": "node relay/start.ts",
    "relay:users": "node relay/manage.ts",
    "dev": "vite dev",
    "start:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-windows.ps1",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run test && npm run build && npm run test:e2e",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "release:version": "node scripts/release.ts version"
  },
  "license": "MIT",
  "overrides": {
    "cookie": "^0.7.2"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@lucide/svelte": "^1.43.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "dompurify": "^3.3.0",
    "highlight.js": "^11.12.0",
    "marked": "^17.0.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^24.0.0",
    "@types/web-push": "^3.6.4",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.0.0"
  }
}
